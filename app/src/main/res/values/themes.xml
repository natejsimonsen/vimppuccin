<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vimppuccin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/mauve</item>
        <item name="android:colorPrimaryDark">@color/mantle</item>
        <item name="android:colorAccent">@color/mauve</item>
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/subtext</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/subtext</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BigNumber">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SecondaryButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/mauve</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
</resources>
